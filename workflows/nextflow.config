/*
 * Nextflow configuration for CPPF–Tubulin Phase 1 workflow.
 *
 * Run from repository root:
 *   nextflow run workflows/main.nf -profile local
 */

params {
    conda_base = '${HPC_WORKSPACE}/miniconda3/envs'
}

workDir = 'workflows/work'

profiles {
    local {
        process.executor = 'local'
        conda.enabled = true
    }

    hpc {
        process.executor = 'slurm'
        conda.enabled = true
        process.queue = 'gpu'
        process.clusterOptions = '--partition=gpu --gres=gpu:1'
    }
}

process {
    errorStrategy = 'terminate'
    maxRetries = 1

    withName: 'RESP2_CHARGES' {
        conda = "${params.conda_base}/mdprep"
        cpus = 8
        time = '2h'
        memory = '16 GB'
    }

    withName: 'PREPARE_TOPOLOGY_PROC' {
        conda = "${params.conda_base}/mdprep"
        cpus = 1
        time = '15m'
        memory = '4 GB'
    }

    withName: 'ENERGY_MINIMIZE' {
        conda = "${params.conda_base}/gmx-lite"
        cpus = 8
        time = '2h'
        memory = '24 GB'
    }

    withName: 'NVT_EQUIL' {
        conda = "${params.conda_base}/gmx-lite"
        cpus = 8
        time = '4h'
        memory = '24 GB'
    }

    withName: 'NPT_EQUIL' {
        conda = "${params.conda_base}/gmx-lite"
        cpus = 8
        time = '4h'
        memory = '24 GB'
    }

    withName: 'PRODUCTION_MD' {
        conda = "${params.conda_base}/gmx-lite"
        cpus = 8
        time = '48h'
        memory = '32 GB'
        clusterOptions = '--partition=gpu --gres=gpu:1 --mem=32G'
    }

    withName: 'PBC_CORRECTION' {
        conda = "${params.conda_base}/gmx-lite"
        cpus = 4
        time = '6h'
        memory = '24 GB'
    }

    withName: 'EXPORT_XVG' {
        conda = "${params.conda_base}/gmx-lite"
        cpus = 4
        time = '6h'
        memory = '24 GB'
    }

    withName: 'MMPBSA' {
        conda = "${params.conda_base}/mmpbsa"
        cpus = 4
        time = '6h'
        memory = '24 GB'
    }

    withName: 'FEL_CALCULATION' {
        conda = "${params.conda_base}/mdprep"
        cpus = 2
        time = '1h'
        memory = '8 GB'
    }

    withName: /PLOT_.*/ {
        conda = "${params.conda_base}/mdprep"
        cpus = 2
        time = '30m'
        memory = '8 GB'
    }

    withName: 'AGGREGATE_MMPBSA' {
        conda = "${params.conda_base}/mdprep"
        cpus = 1
        time = '30m'
        memory = '4 GB'
    }

    withName: 'GENERATE_REPORT' {
        conda = "${params.conda_base}/mdprep"
        cpus = 1
        time = '10m'
        memory = '2 GB'
    }
}
