# GROMACS / MD large or generated binaries
*.xtc
# Tiny symlink aliases for dimer segments (docs/DIMER_TRAJECTORY_NAMING.md)
!revision_exec/rep1/prod/segment_*.xtc
!revision_exec/rep2/prod/segment_*.xtc
!revision_exec/rep3/prod/segment_*.xtc
*.trr
*.tng
*.edr
*.cpt
*.gro
*.trj

# Common analysis outputs
*.xvg
*.eps
*.xpm
*.pdbqt

# Revision Step 2/3: full raw xvg trees and local work dirs (can be GB-scale)
revision_exec/analysis_revision/raw_xvg/
revision_exec/analysis_revision/work/
revision_exec/analysis_revision/_smoke/
revision_exec/analysis_revision/figures/
revision_exec/analysis_revision/tables/
revision_exec/analysis_revision/fel/

# MM-PBSA work directories can be very large; keep inputs/scripts + summary only
revision_exec/analysis/mmpbsa/work_*/
revision_exec_6e7b/analysis/mmpbsa/work_*/

# Keep primary docs/scripts/config under version control.

# Allow selected GROMACS text/binary outputs under revision_exec (still < GitHub 100 MiB/file in practice).
# Large *.xtc / most *.trr remain ignored; see docs/git_binary_data.md and revision_exec/LARGE_FILES_NOT_IN_GIT.txt
!revision_exec/**/*.edr
!revision_exec/**/*.cpt
!revision_exec/**/*.gro
!revision_exec/**/*.xvg
!revision_exec/**/*.log

# But do NOT add full production outputs under revision_exec/**/prod (prefer HF / external archive).
revision_exec/**/prod/*.tpr
revision_exec/**/prod/*.cpt
revision_exec/**/prod/*.edr
revision_exec/**/prod/*.gro
revision_exec/**/prod/*.log

# Also ignore the monomer replicate trees in this repo clone (they contain large `prod/*` outputs).
# Preparation inputs are already captured in tracked scripts/docs; full production artifacts live on HF.
revision_exec/monomer_alpha_rep2/
revision_exec/monomer_alpha_rep3/
revision_exec/monomer_beta_rep2/
revision_exec/monomer_beta_rep3/

# 6E7B supplementary MD — large production outputs stay on HF, not Git
revision_exec_6e7b/md/
revision_exec_6e7b/logs/
revision_exec_6e7b/prep/*.gro
revision_exec_6e7b/prep/*.log
revision_exec_6e7b/prep/*.cpt
revision_exec_6e7b/prep/*.edr
revision_exec_6e7b/prep/*.tpr
revision_exec_6e7b/prep/#*
revision_exec_6e7b/*.gro
revision_exec_6e7b/*.pdb
revision_exec_6e7b/mdout.mdp
# Keep committed analysis artifacts (plots, xvg) for reproducibility
!revision_exec_6e7b/analysis/**/*.xvg
!revision_exec_6e7b/analysis/plots/**
!revision_exec_6e7b/prep/alignment_summary.txt
