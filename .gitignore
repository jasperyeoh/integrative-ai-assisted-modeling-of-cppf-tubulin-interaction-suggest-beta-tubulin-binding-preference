# Python / general cache
__pycache__/
*.py[cod]
*.so
.DS_Store

# Secrets (Zenodo, Hugging Face, etc.)
.zenodo_token
.huggingface_token
revision_exec/scripts/HF_DATASET_REPO.env

# Environment and local IDE
.env
.venv/
venv/
.idea/
.vscode/

# Logs and temporary files
nohup.out
*.log
*.log.*
\#*#
*.tmp
*.bak

# GROMACS / MD large or generated binaries
*.xtc
*.trr
*.tng
*.edr
*.cpt
*.gro
*.trj

# Common analysis outputs
*.xvg
*.eps
*.xpm
*.pdbqt

# Keep primary docs/scripts/config under version control.

# Allow selected GROMACS text/binary outputs under revision_exec (still < GitHub 100 MiB/file in practice).
# Large *.xtc / most *.trr remain ignored; see docs/git_binary_data.md and revision_exec/LARGE_FILES_NOT_IN_GIT.txt
!revision_exec/**/*.edr
!revision_exec/**/*.cpt
!revision_exec/**/*.gro
!revision_exec/**/*.xvg
!revision_exec/**/*.log
